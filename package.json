{
  "name": "forge-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --parallel --filter dashboard --filter worker dev",
    "dashboard": "pnpm --filter dashboard dev",
    "worker": "pnpm --filter worker dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter worker build && pnpm --filter dashboard build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "visual-qa": "pnpm --filter @forge/visual-qa visual-qa",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.35.1",
    "typescript": "^5.8.3"
  }
}
